# ==========================================
# SOFT SKILL GAME
# Ren'Py 8.5.3
# Levels: Ali and Amir
# ==========================================

init python:
    config.rtl = True

# ------------------------------------------
# CHARACTER DEFINITIONS
# ------------------------------------------

define manager = Character("مدیر استخدام")
define ali = Character("علی")
define amir = Character("امیر")
image ali_scene = Movie(play="videos/ali.webm")
image amir_scene = Movie(play="videos/amir.webm")


# ------------------------------------------
# GAME VARIABLES
# ------------------------------------------

default interview_passed = True
default ali_passed = True
default amir_passed = True


# ------------------------------------------
# BACKGROUND
# ------------------------------------------

image orange_bg = Solid("#F28C28")
image manager_scene = "images/manager_scene.png"
image ali_scene = "images/ali_scene.png"
image amir_scene = "images/amir_scene.png"
image ending = "images/ending.png"

# ==========================================
# START
# ==========================================

label start:

    $ total_score = 0
    $ interview_score = 0

    stop music fadeout 1.0
    play music "audio/background_music.mp3" fadein 2.0 loop
    scene ending
    with fade

    jump interview_level

# ==========================================
# LEVEL 2: ALI
# Skills:
# Emotional Intelligence, Communication,
# Cooperation, Team Building,
# Operational Planning
# ==========================================

label interview_level:

    scene manager_scene
    with fade
    $ interview_passed = True

    manager "بشینید. رزومه‌تون رو خوندم، اما بیشتر از سابقه‌تون می‌خوام بدونم چطور تصمیم می‌گیرید. مخصوصاً وقتی منافع شخصی و منافع تیم با هم در تضاد قرار می‌گیرن."

    # سؤال اول
    manager "چند ساعت تا تحویل پروژه مونده و متوجه می‌شید یکی از اعضای تیم اشتباه بزرگی کرده. گفتنش ممکنه باعث اخراجش بشه، ولی پنهان‌کردنش هم می‌تونه کل تیم رو شکست بده. چیکار می‌کنید؟"

    menu:
        "A) «فعلاً چیزی نمی‌گم؛ شاید بتونم قبل از اینکه کسی متوجه بشه، اشتباهش رو جبران کنم.»":
            $ interview_passed = False

        "B) «موضوع رو مطرح می‌کنم، ولی نمی‌خوام فقط دنبال مقصر بگردیم؛ باید راه جبرانش رو هم پیدا کنیم.»":
            pass

        "C) «به نظرم بهتره خودش تصمیم بگیره حقیقت رو بگه؛ نمی‌خوام اعتمادش رو از بین ببرم.»":
            $ interview_passed = False

    # سؤال دوم
    manager "مدیرعامل ازتون می‌خواد گزارشی رو تأیید کنید که می‌دونید بخشی از اطلاعاتش اشتباهه. مخالفت ممکنه فرصت پیشرفتتون رو بگیره، اما تأییدش هم می‌تونه تصمیم اشتباهی برای شرکت ایجاد کنه. چیکار می‌کنید؟"

    menu:
        "A) «اگه مسئولیت تصمیم نهایی با مدیرعامله، بهتره من وارد اختلاف باهاش نشم.»":
            $ interview_passed = False

        "B) «گزارش رو تأیید نمی‌کنم؛ فکر می‌کنم اصلاحش وظیفه کسیه که تهیه‌اش کرده.»":
            $ interview_passed = False

        "C) «اشتباه‌ها رو مشخص می‌کنم و نسخه اصلاح‌شده می‌دم؛ حتی اگه موقعیتم رو به خطر بندازه.»":
            pass

    # سؤال سوم
    manager "یکی از مدیران ارشد ازتون می‌خواد تاریخ واقعی انجام کار رو تغییر بدید تا پروژه به‌موقع تموم‌شده به نظر برسه. می‌گه اگه همکاری نکنید، کل تیم به دردسر می‌افته. چه واکنشی نشون می‌دید؟"

    menu:
        "A) «اگه این تغییر به نفع تیم باشه، انجامش می‌دم؛ بالاخره مدیر ارشد بهتر شرایط رو می‌دونه.»":
            $ interview_passed = False

        "B) «قبول می‌کنم، ولی می‌خوام درخواستش رو کتبی تأیید کنه تا مسئولیتش مشخص باشه.»":
            $ interview_passed = False

        "C) «تاریخ واقعی رو ثبت می‌کنم و راهی پیشنهاد می‌دم که بدون تغییر واقعیت، گزارش قابل دفاع باشه.»":
            pass

    # بررسی نتیجه مصاحبه
    if interview_passed == True:

        manager "جالبه... به نظر می‌رسه فقط دنبال حقوق آخر ماه نیستید. از فردا کارتون رو شروع می‌کنید. فقط یه توصیه: اینجا همه آدما اون چیزی نیستن که نشون می‌دن؛ به هیچ‌کس زود اعتماد نکنید."

        jump ali_level

    else:
        label interview_fired:
            scene manager_scene
            

            manager "متأسفم، اما به نظر می‌رسه هنوز آمادگی لازم برای این موقعیت شغلی رو ندارید."

            "شما در مصاحبه استخدامی پذیرفته نشدید."

            jump game_end

            return
            
            

# ==========================================
# LEVEL 2: ALI
# Skills:
# Emotional Intelligence, Communication,
# Cooperation, Team Building,
# Operational Planning
# ==========================================

label ali_level:

    $ ali_passed = True
    scene ali_scene
    with fade

    ali "سلام، من علی‌ام. معمولاً ترجیح می‌دم هرکس کار خودش رو انجام بده. تجربه بهم نشون داده همکاری زیاد، گاهی دردسرهای بقیه رو هم می‌ندازه گردن آدم."

    # --------------------------------------
    # QUESTION 1 - Lack of Cooperation
    # Correct Answer: B
    # --------------------------------------

    "موقعیت اول: علی با شما همکاری نمیکند"

    ali "الان واقعاً سرم شلوغه. نمی‌تونم درگیر کارت بشم؛ خودت یه راهی پیدا کن، منم مسئول کارهای خودمم."

    menu:

        "A) «باشه، فعلاً با اطلاعات موجود جلو می‌رم؛ اگه مشکلی پیش اومد بعداً حلش می‌کنیم.»":
            $ ali_passed = False

        "B) «می‌دونم سرت شلوغه، ولی کارت به اطلاعات من وابسته‌ست؛ بیا با مدیر درباره دسترسی‌ها هماهنگ کنیم.»":
            pass

        "C) «باشه، پس فعلاً دست نگه می‌دارم؛ نمی‌خوام بدون هماهنگی تو تصمیمی بگیرم که بعداً دردسر بشه.»":
            $ ali_passed = False


    # --------------------------------------
    # QUESTION 2 - Avoiding Responsibility
    # Correct Answer: A
    # --------------------------------------

    "موقعیت دوم: علی از مسئولیتش شانه خالی میکند"

    ali "من بخش خودمو به‌موقع تحویل دادم. اگه بقیه عقب افتادن، دیگه مشکل من نیست؛ قرار نیست مسئولیت همه رو قبول کنم."

    menu:

        "A) «تو جلسه روند کار و درخواست‌هایی که ازت داشتم رو با مدرک توضیح می‌دم؛ بذار مدیر خودش قضاوت کنه.»":

            pass

        "B) «فعلاً سکوت می‌کنم؛ نمی‌خوام برای یه تأخیر، رابطه کاری‌مون خراب بشه.»":

            $ ali_passed = False

        "C) «منم می‌گم تأخیر به خاطر تو بوده؛ نمی‌خوام مسئولیت اشتباه بقیه رو قبول کنم.»":

            $ ali_passed = False


    # --------------------------------------
    # QUESTION 3 - Personal vs Team Success
    # Correct Answer: B
    # --------------------------------------

    "موقعیت سوم:‌علی به موفقیت تیم اهمیت نمیدهد"

    ali "من کار خودمو انجام دادم. اینکه بقیه عقب هستن مشکل من نیست؛ قرار هم نیست به خاطر کسی اضافه‌کاری کنم."

    menu:

        "A) «خودم باقی کار رو انجام می‌دم؛ نمی‌خوام به خاطر اختلاف با علی کل پروژه شکست بخوره.»":

            $ ali_passed = False

        "B) «با مدیر درباره اولویت‌ها صحبت می‌کنم تا کارها دوباره تقسیم بشن و پروژه از مسیر خارج نشه.»":

            pass

        "C) «وقتی علی حاضر به همکاری نیست، منم ترجیح می‌دم فقط وظایف خودم رو انجام بدم.»":

            $ ali_passed = False


    # --------------------------------------
    # ALI ENDING
    # --------------------------------------
    if ali_passed == True:
        
        ali "باورم نمیشه بخاطر یه نیروی کار جدید باید روش کارمو تغییر بدم، ولی بیا باهم کنار بیایم."

        jump amir_level
    
    else: 
        label ali_fired:
            scene manager_scene
            with fade

            manager "عملکرد شما در همکاری با اعضای تیم قابل قبول نبود. متأسفانه مجبوریم همکاری رو با شما قطع کنیم."

            "شما از شرکت اخراج شدید."
            
            jump game_end

            return 

# ==========================================
# LEVEL 3: AMIR
# Skills:
# Stress Management, Emotional Intelligence,
# Verbal Communication, Analytical Thinking,
# Problem Solving, Professional Ethics
# ==========================================

label amir_level:

    $ amir_passed = True
    scene amir_scene
    with fade

    amir "آها! نیروی جدید! خوش اومدی، من امیرم. اینجا فقط یه چیز رو یادت نره؛ همیشه حواست باشه اشتباهات دیگران به اسم تو تموم نشه!"


    # --------------------------------------
    # QUESTION 1 - Accused of Others' Mistake
    # Correct Answer: B
    # --------------------------------------



    "موقعیت اول: امیر در حضور چند نفر شما را متهم می‌کند."

    amir "دیروز تو آخرین نفری بودی که با اون فایل کار کردی، الانم فایل نیست! فکر کنم بهتره توضیح بدی چه اتفاقی افتاده."

    "شما مطمئنید که فایل را حذف نکرده اید."

    menu:

        "A) «قبل از اینکه منو متهم کنی، بهتره مطمئن بشی خودت اشتباهی نکرده باشی!»":

            $ amir_passed = False

        "B) «من فایل رو حذف نکردم؛ بیاید تاریخچه دسترسی‌ها رو بررسی کنیم تا بفهمیم چی شده.»":

            pass

        "C) «الان وقت بحث نیست؛ من دوباره فایل رو آماده می‌کنم تا پروژه متوقف نشه.»":

            $ amir_passed = False


    # --------------------------------------
    # QUESTION 2 - Accusation in a Meeting
    # Correct Answer: A
    # --------------------------------------

    "موقعیت دوم: امیر در جلسه به شما اتهام میزند"

    amir "من از اول هم به عملکرد نیروی جدید مشکوک بودم. چند بار دیدم بدون هماهنگی سراغ فایل‌های پروژه می‌رفت."

    "شما می‌دانید که با اجازه مدیر به فایل‌ها دسترسی داشته اید."

    menu:

        "A) «دسترسی من با تأیید مدیر بوده؛ می‌تونم مجوزها و وظایفی رو که داشتم نشون بدم.»":

            pass

        "B) «امیر از اول با من مشکل داشته؛ شاید بهتر باشه رفتارهای خودش هم بررسی بشه!»":

            $ amir_passed = False

        "C) «الان نمی‌خوام بحث رو طولانی کنم؛ ترجیح می‌دم مدیر خودش موضوع رو بررسی کنه.»":

            $ amir_passed = False


    # --------------------------------------
    # QUESTION 3 - Accusation Despite Evidence
    # Correct Answer: B
    # --------------------------------------

    
    "موقعیت: بررسی اولیه نشان می‌دهد حساب کاربری امیر نیز هنگام حذف فایل به پروژه دسترسی داشته است. مدیر از او سؤال می‌کند."

    amir "خب که چی؟ منم دسترسی داشتم، دلیل نمی‌شه کاری کرده باشم! همه دارن منو متهم می‌کنن، درحالی‌که مشکل از اول با این نیروی جدیده!"

    amir "بهتره قبل از اینکه بیشتر دردسر درست کنی، قبول کنی اشتباه از خودت بوده!"

    menu:

        "A) «مدیر، دیگه مشخصه امیر هم دسترسی داشته؛ به نظرم باید مسئولیت این اتفاق رو قبول کنه.»":

            $ amir_passed = False

        "B) «من نمی‌خوام بر اساس حدس کسی رو مقصر بدونم؛ بیاید همه دسترسی‌ها و تغییرات رو بررسی کنیم.»":

            pass

        "C) «امیر، بیا این موضوع رو همین‌جا تموم کنیم؛ نمی‌خوام اختلافمون روی کار تیم تأثیر بذاره.»":

            $ amir_passed = False


    # --------------------------------------
    # AMIR ENDING
    # --------------------------------------

    if amir_passed == True:
    
        amir "عجب! انگار اینجا همه باید جواب پس بدن جز تو! باشه، فعلاً چیزی نمی‌گم؛ ولی این ماجرا هنوز تموم نشده."

        jump successful_ending

    else: 
        label amir_fired:
            scene manager_scene
            with fade

            manager "انتظار بیشتری از شما داشتم. تصمیم‌هایی که گرفتید نشون داد هنوز برای این مسئولیت آماده نیستید."

            "شما از شرکت اخراج شدید."

    return


# ==========================================
# GAME END
# ==========================================

label game_end:

    stop music fadeout 2.0
    scene ending
    with fade
    "بازی به پایان رسید!"
    "شما باختید!"
    return

label successful_ending:

    scene manager_scene
    with fade

    manager "عملکرد شما در این مدت واقعاً قابل توجه بوده."

    manager "تصمیم گرفتیم شما رو به سمت بالاتری ارتقا بدیم و حقوقتون رو هم افزایش بدیم."

    scene ending
    with fade
    "شما با موفقیت تمام مراحل رو پشت سر گذاشتید!"

    return